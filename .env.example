# ============ Meta WhatsApp Cloud API ============
# developers.facebook.com -> your app -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=v26.0

# (Placeholders only. Never put real values in this file - copy it to .env, which is git-ignored.)

# ============ Webhook (delivery receipts + STOP replies) ============
# Any random string you invent. Paste the SAME value into Meta -> WhatsApp -> Configuration.
WEBHOOK_VERIFY_TOKEN=
# Meta app -> App settings -> Basic -> App secret (used to verify webhooks are really from Meta)
META_APP_SECRET=
# Local experiments only. Leave false: unsigned webhooks could fake delivery/STOP events.
WEBHOOK_ALLOW_UNSIGNED=false

# ============ Safety ============
# true  = simulate only, nothing reaches Meta.   false = REAL messages.
SAFE_MODE=true
# Meta allows this many unique people per rolling 24h until your tier is raised (unverified = 250).
DAILY_RECIPIENT_LIMIT=250
# Your own number (digits, with country code, e.g. 15550001234). Only this number can receive the "send test" button.
OWNER_WHATSAPP_NUMBER=
DEFAULT_COUNTRY_CODE=91
DEFAULT_TEMPLATE_LANGUAGE=pa

# ============ Dashboard protection ============
# REQUIRED when the dashboard is reachable from the internet. Leave empty for local-only use.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# ============ Tuning (optional) ============
SEND_DELAY_SECONDS=0.3
MAX_RETRIES=3
FAILURE_CIRCUIT_BREAKER=5
